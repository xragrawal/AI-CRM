# Database - Neon PostgreSQL
# Get these from your Neon project dashboard
# DATABASE_URL should be the POOLED connection string (contains -pooler)
# DIRECT_URL should be the DIRECT connection string (no -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DATABASE?sslmode=require"

# AI Provider API Keys
# You can use either Gemini or OpenAI (or both)

# Gemini API Key (Google AI)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
# Optional: override the Gemini model name
GEMINI_MODEL="gemini-2.0-flash"

# OpenAI API Key
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key-here"
# Optional: override the OpenAI model name
OPENAI_MODEL="gpt-4o-mini"
# Optional: custom OpenAI-compatible endpoint (e.g., for local models)
OPENAI_BASE_URL="https://api.openai.com/v1"
